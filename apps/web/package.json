{
  "name": "@pinshelf/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc6 --noEmit",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply pinshelf --local",
    "db:migrate:remote": "wrangler d1 migrations apply pinshelf --remote",
    "postinstall": "WRANGLER_LOG=warn wrangler types"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.5",
    "@pinshelf/shared": "workspace:*",
    "@scalar/api-reference-react": "^0.9.70",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
