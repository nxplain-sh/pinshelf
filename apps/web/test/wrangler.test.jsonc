{
  "name": "pinshelf-test",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinshelf-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "pinshelf-backups-test",
    },
  ],
  "vars": {
    "BETTER_AUTH_SECRET": "test-only-secret-never-used-in-production",
    "BETTER_AUTH_URL": "http://pinshelf.test",
  },
}
