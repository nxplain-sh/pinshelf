# Cloudflare credentials for the Wrangler CLI.
#
# Only needed when you are not using `wrangler login`, for example in CI or
# on a machine where you prefer tokens. Copy to `.env` (gitignored) and fill in.
#
# Required token permissions: Workers Scripts (Edit), D1 (Edit),
# and Account Settings (Read). See docs/deployment notes in README.md.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
